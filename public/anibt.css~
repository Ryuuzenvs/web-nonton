.anime-card-effect {
    position: relative; /* Penting untuk posisi ::before */
    overflow: hidden; /* Agar efek berkilau tidak keluar dari kartu */
    transition: transform 0.3s ease-in-out; /* Animasi zoom ringan */
}

.anime-card-effect:hover {
    transform: translateY(-5px); /* Sedikit naik saat di-hover */
}

.anime-card-effect::before {
    content: '';
    position: absolute;
    top: 0;
    left: -75%; /* Mulai dari kiri luar */
    width: 50%;
    height: 100%;
    background: rgba(255, 255, 255, 0.3); /* Warna kilau */
    transform: skewX(-20deg); /* Miringkan */
    transition: all 0.7s ease-in-out; /* Animasi pergerakan */
    z-index: 1; /* Pastikan di atas konten kartu */
}

.anime-card-effect:hover::before {
    left: 125%; /* Bergerak ke kanan luar */
}
